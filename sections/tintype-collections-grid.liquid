<section class="tt-collections" id="TintypeCollections-{{ section.id }}">
  <div class="tt-section-header">
    {%- if section.settings.label != blank -%}
      <span class="tt-section-label">{{ section.settings.label }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="tt-section-title">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="tt-collections__grid">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      <a
        href="{{ collection.url | default: '#' }}"
        class="tt-collection-card tt-fade-in"
        {{ block.shopify_attributes }}
      >
        <div class="tt-collection-card__bg">
          {%- if collection.image != blank -%}
            {{
              collection.image
              | image_url: width: 1200
              | image_tag:
                width: collection.image.width,
                height: collection.image.height,
                alt: collection.title,
                sizes: '(min-width: 768px) 50vw, 100vw',
                widths: '400, 600, 800, 1200',
                loading: 'lazy'
            }}
          {%- elsif block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                width: block.settings.image.width,
                height: block.settings.image.height,
                alt: block.settings.title,
                sizes: '(min-width: 768px) 50vw, 100vw',
                widths: '400, 600, 800, 1200',
                loading: 'lazy'
            }}
          {%- else -%}
            <div class="tt-collection-card__bg-placeholder"></div>
          {%- endif -%}
        </div>
        <div class="tt-collection-card__content">
          <h3 class="tt-collection-card__name">
            {{ collection.title | default: block.settings.title }}
          </h3>
          {%- if block.settings.subtitle != blank -%}
            <span class="tt-collection-card__count">{{ block.settings.subtitle }}</span>
          {%- elsif collection != blank -%}
            <span class="tt-collection-card__count">{{ collection.products_count }} DESIGNS</span>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Tintype Collections",
  "tag": "section",
  "class": "tt-collections-wrapper section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Browse By"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "COLLECTIONS"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title (fallback)",
          "default": "HERITAGE PHOTOS"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "12 DESIGNS • 1920s-1990s"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tintype Collections",
      "category": "Tintype",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "title": "HERITAGE PHOTOS",
            "subtitle": "12 DESIGNS • 1920s-1990s"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "LOST MARKS",
            "subtitle": "8 DESIGNS • 1880s-1950s"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<section class="tt-process" id="TintypeProcess-{{ section.id }}">
  <div class="tt-process__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="tt-process__heading tt-fade-in">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="tt-process__grid">
      {%- for block in section.blocks -%}
        <div class="tt-process__card tt-fade-in" {{ block.shopify_attributes }}>
          <div class="tt-process__number">{{ block.settings.number | default: forloop.index | prepend: '00' | slice: -2, 2 }}</div>
          <div class="tt-process__icon">
            {{ block.settings.icon_svg }}
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tintype Process",
  "tag": "section",
  "class": "tt-process-wrapper section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HOW WE WORK"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Step number",
          "default": "01"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG",
          "default": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='11' cy='11' r='8'></circle><path d='m21 21-4.35-4.35'></path></svg>"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "DISCOVER"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "We source authentic photographs from family archives and hunt for rare vintage logos from America's industrial past."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tintype Process",
      "category": "Tintype",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "01",
            "icon_svg": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='11' cy='11' r='8'></circle><path d='m21 21-4.35-4.35'></path></svg>",
            "title": "DISCOVER",
            "text": "We source authentic photographs from family archives and hunt for rare vintage logos from America's industrial past."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "icon_svg": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'></path><polyline points='14 2 14 8 20 8'></polyline><line x1='16' y1='13' x2='8' y2='13'></line><line x1='16' y1='17' x2='8' y2='17'></line></svg>",
            "title": "DOCUMENT",
            "text": "Every image gets its story researched and recorded. Names, dates, places, occupations — we preserve what we can find."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "icon_svg": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><rect x='3' y='3' width='18' height='18' rx='2' ry='2'></rect><circle cx='8.5' cy='8.5' r='1.5'></circle><polyline points='21 15 16 10 5 21'></polyline></svg>",
            "title": "RESTORE",
            "text": "Careful digital restoration brings faded images back to life while preserving their authentic character and imperfections."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "04",
            "icon_svg": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z'></path><line x1='7' y1='7' x2='7.01' y2='7'></line></svg>",
            "title": "CREATE",
            "text": "Printed on premium USA-made cotton using quality methods that ensure the image lasts as long as the fabric."
          }
        }
      ]
    }
  ]
}
{% endschema %}
